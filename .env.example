# Copy this file to .env and fill in your values. .env is ignored by Git,
# so your key stays on your computer. Never put a real key in this file.

# Optional: turns on Claude-written chatbot answers.
# Create a key at https://console.anthropic.com (Settings → API Keys).
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown)
# CHAT_MODEL=claude-opus-5-5
# CHAT_RATE_LIMIT=12
